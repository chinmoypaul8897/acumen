# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Values are read at the point of use through acumen.config.env_value() and are never
# printed, logged, echoed or put in a repr. A bare clone needs NONE of these: the full
# test suite and every offline backtest run without credentials -- only the network
# paths (data backfill and the live screener) read them.
#
# The empty values are written as "" on purpose: a bare `KEY=` followed by a trailing
# comment parses as the COMMENT TEXT, which would defeat the loader's "which key is
# missing" guard for anyone who copies this file without filling it in.

SMARTAPI_KEY=""          # Angel One SmartAPI app key -- data access fails without it
SMARTAPI_CLIENT_CODE=""  # SmartAPI login client code -- login is refused without it
SMARTAPI_PIN=""          # SmartAPI login PIN -- login is refused without it
SMARTAPI_TOTP_SECRET=""  # TOTP secret for SmartAPI 2FA login -- no session token without it

TELEGRAM_BOT_TOKEN=""    # Telegram bot token -- live alerts won't send without it
TELEGRAM_CHAT_ID=""      # Telegram chat id the alerts are sent to -- nowhere to send without it
